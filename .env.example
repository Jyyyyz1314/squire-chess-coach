# AI Key 由每位用户在网页“AI 设置”中填写；服务端不保存共享模型密钥。
COACH_API_ENABLED=true

# 商业部署前请按套餐调整；当前为单实例的基础保护。
COACH_RATE_LIMIT_PER_MINUTE=12
COACH_RATE_LIMIT_PER_DAY=120

# Lichess OAuth2 + PKCE。client id 可留空，届时使用当前站点域名。
# 请生成至少 32 字符的随机值；它只用于服务端加密登录令牌。
LICHESS_CLIENT_ID=
LICHESS_SESSION_SECRET=replace_with_a_random_secret_of_at_least_32_characters
